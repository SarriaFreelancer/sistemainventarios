{
  "name": "dulche-dorelle-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm exec prisma db push --skip-generate && pnpm exec next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next', {recursive:true, force:true})\" && pnpm exec prisma db push --skip-generate && pnpm exec next dev",
    "build": "npx prisma db push --skip-generate && next build",
    "build:e2e": "cross-env NODE_ENV=production DATABASE_URL=$DATABASE_URL NEXTAUTH_URL=$NEXTAUTH_URL NEXTAUTH_SECRET=$NEXTAUTH_SECRET pnpm build",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "pm2:dev": "pm2 start ecosystem.config.cjs --only gns-dev",
    "pm2:prod": "pm2 start ecosystem.config.cjs --only gns",
    "pm2:restart": "pm2 restart all",
    "pm2:stop": "pm2 stop all",
    "pm2:save": "pm2 save",
    "prisma:generate": "prisma generate --schema=prisma/platform/schema.prisma && prisma generate --schema=prisma/tenant/schema.prisma",
    "prisma:deploy:platform": "prisma migrate deploy --schema=prisma/platform/schema.prisma",
    "prisma:deploy:tenant": "prisma migrate deploy --schema=prisma/tenant/schema.prisma",
    "prisma:migrate:platform": "prisma migrate dev --schema=prisma/platform/schema.prisma",
    "prisma:migrate:tenant": "prisma migrate dev --schema=prisma/tenant/schema.prisma",
    "db:seed": "prisma db seed",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@types/file-saver": "^2.0.7",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "driver.js": "^1.8.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.469.0",
    "next": "^15.5.23",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "node-cron": "^4.6.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.18.0",
    "sonner": "^1.7.4",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^2.6.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.4",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.26",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
