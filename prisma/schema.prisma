generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  SUPERADMIN
  USER
}

enum SaleStatus {
  PENDING
  REVIEWED
  PAID
  COMPLETED
  VOIDED
  RETURNED
}

enum DiscountScope {
  GLOBAL
  PRODUCT
  PRODUCTS
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProductStatus {
  AVAILABLE
  OUT_OF_STOCK
}

enum ProductType {
  SALE
  RAW_MATERIAL
  FINISHED_GOOD
  SUPPLY
  SERVICE
  FIXED_ASSET
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  WON
}

enum OpportunityStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum ExpenseCategory {
  MARKETING
  SUPPLIES
  UTILITIES
  PAYROLL
  INVENTORY_COST
  OTHER
}

enum IncomeCategory {
  SALES
  SERVICES
  INVESTMENT
  OTHER
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id            Int            @id @default(autoincrement())
  name          String
  email         String?        @unique
  phone         String?
  company       String?
  address       String?
  city          String?
  country       String         @default("Colombia")
  status        CustomerStatus @default(ACTIVE)
  companyId     Int?
  tenantCompany Company?       @relation(fields: [companyId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  opportunities Opportunity[]
  contacts      Contact[]
  activities    Activity[]
  quotes        Quote[]
  code          String?
  sales         Sale[]

  @@index([companyId])
}

model Opportunity {
  id             Int              @id @default(autoincrement())
  title          String
  customerId     Int
  stage          OpportunityStage @default(NEW)
  estimatedValue Float            @default(0)
  probability    Int              @default(0)
  companyId      Int?
  company        Company?         @relation(fields: [companyId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  customer       Customer         @relation(fields: [customerId], references: [id])

  @@index([companyId])
  @@index([customerId])
}

model PurchaseOrder {
  id                Int                 @id @default(autoincrement())
  orderNumber       String              @unique
  supplierId        Int
  status            PurchaseOrderStatus @default(DRAFT)
  total             Float               @default(0)
  expectedDelivery  DateTime?
  companyId         Int?
  company           Company?            @relation(fields: [companyId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  supplier          Supplier            @relation(fields: [supplierId], references: [id])
  lines             PurchaseOrderLine[]
  purchaseRequestId Int?
  purchaseRequest   PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  quotationId       Int?
  quotation         PurchaseQuotation?  @relation(fields: [quotationId], references: [id])
  subtotal          Float               @default(0)
  taxAmount         Float               @default(0)
  notes             String?             @db.Text
  terms             String?             @db.Text
  receipts          PurchaseReceipt[]
  invoices          PurchaseInvoice[]

  @@index([companyId])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id               Int              @id @default(autoincrement())
  purchaseOrderId  Int
  productId        Int?
  quantity         Int              @default(1)
  unitPrice        Float            @default(0)
  total            Float            @default(0)
  companyId        Int?
  company          Company?         @relation(fields: [companyId], references: [id])
  purchaseOrder    PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product          Product?         @relation(fields: [productId], references: [id])
  description      String?
  itemType         PurchaseItemType @default(PRODUCTO_VENTA)
  taxRate          Float            @default(0)
  receivedQuantity Int              @default(0)

  @@index([companyId])
  @@index([purchaseOrderId])
  @@index([productId])
}

model Expense {
  id          Int             @id @default(autoincrement())
  description String
  amount      Float
  category    ExpenseCategory @default(OTHER)
  date        DateTime        @default(now())
  companyId   Int?
  company     Company?        @relation(fields: [companyId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companyId])
}

model Income {
  id          Int            @id @default(autoincrement())
  description String
  amount      Float
  category    IncomeCategory @default(OTHER)
  date        DateTime       @default(now())
  companyId   Int?
  company     Company?       @relation(fields: [companyId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([companyId])
}

model ProductGroup {
  id         Int        @id @default(autoincrement())
  name       String
  code       String?
  status     String     @default("ACTIVE")
  companyId  Int?
  company    Company?   @relation(fields: [companyId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  products   Product[]
  categories Category[]

  @@unique([name, companyId])
  @@index([companyId])
}

model User {
  id                   Int                   @id @default(autoincrement())
  name                 String
  email                String                @unique
  password             String
  image                String?
  roleId               Int?
  role                 Role?                 @relation(fields: [roleId], references: [id])
  companyId            Int?
  company              Company?              @relation(fields: [companyId], references: [id])
  position             String? // Cargo o puesto (e.g., "Vendedor", "Gerente")
  preferences          Json? // Preferencias de UI/tema (e.g., {"theme": "dark"})
  lastLogin            DateTime? // Fecha/hora del último inicio de sesión
  rememberMe           Boolean               @default(false)
  failedLoginAttempts  Int                   @default(0)
  isLocked             Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  auditLogs            AuditLog[]
  loginHistories       LoginHistory[]
  sessions             UserSession[]
  sales                Sale[]
  voidedSales          Sale[]                @relation("VoidedSales")
  activities           Activity[]
  notifications        Notification[]
  purchaseRequests     PurchaseRequest[]
  purchaseApprovals    PurchaseApproval[]
  internalRequisitions InternalRequisition[]
  employee             Employee?

  @@index([email])
  @@index([companyId])
}

model Role {
  id          Int              @id @default(autoincrement())
  name        RoleName         @unique
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  modules     RoleModule[]
  users       User[]
}

enum DatabaseEngine {
  MYSQL
  POSTGRESQL
  SQLSERVER
}

enum DatabaseType {
  SHARED
  DEDICATED
}

model Server {
  id       String         @id @default(cuid())
  name     String
  engine   DatabaseEngine
  host     String
  port     Int
  username String
  password String // cifrada
  ssl      Boolean        @default(false)
  active   Boolean        @default(true)

  companies Company[] @relation("ServerCompanies")

  ownerId Int?
  owner   Company? @relation("CompanyServers", fields: [ownerId], references: [id])
}

model Company {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  planId      String?
  maxUsers    Int?
  maxProducts Int?
  maxSalesPerMonth Int?

  serverId     String?
  server       Server?  @relation("ServerCompanies", fields: [serverId], references: [id])
  ownedServers Server[] @relation("CompanyServers")

  databaseName String?
  databaseType DatabaseType? // SHARED | DEDICATED

  currentVersion           String?
  address                  String?
  city                     String?
  country                  String                    @default("Colombia")
  status                   String                    @default("ACTIVE")
  themeConfig              Json?
  setting                  CompanySetting?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  users                    User[]
  modules                  CompanyModule[]
  customers                Customer[]
  opportunities            Opportunity[]
  purchaseOrders           PurchaseOrder[]
  notifications            Notification[]
  purchaseOrderLines       PurchaseOrderLine[]
  expenses                 Expense[]
  incomes                  Income[]
  productGroups            ProductGroup[]
  categories               Category[]
  suppliers                Supplier[]
  products                 Product[]
  sales                    Sale[]
  saleDetails              SaleDetail[]
  auditLogs                AuditLog[]
  loginHistories           LoginHistory[]
  sessions                 UserSession[]
  discounts                Discount[]
  leads                    Lead[]
  contacts                 Contact[]
  activities               Activity[]
  quotes                   Quote[]
  invoiceCounters          InvoiceCounter[]
  purchaseRequests         PurchaseRequest[]
  purchaseRequestItems     PurchaseRequestItem[]
  purchaseApprovalConfigs  PurchaseApprovalConfig[]
  purchaseApprovals        PurchaseApproval[]
  purchaseQuotations       PurchaseQuotation[]
  purchaseQuotationItems   PurchaseQuotationItem[]
  purchaseReceipts         PurchaseReceipt[]
  purchaseReceiptItems     PurchaseReceiptItem[]
  inventoryEntries         InventoryEntry[]
  inventoryEntryItems      InventoryEntryItem[]
  purchaseInvoices         PurchaseInvoice[]
  accountsPayables         AccountsPayable[]
  purchasePayments         PurchasePayment[]
  internalRequisitions     InternalRequisition[]
  internalRequisitionItems InternalRequisitionItem[]
  employees                Employee[]
  positions                Position[]
  payrolls                 Payroll[]
  payrollDetails           PayrollDetail[]
  employeeNovelties        EmployeeNovelty[]

  @@index([name])
}

model Category {
  id             Int            @id @default(autoincrement())
  name           String
  code           String?
  description    String?
  status         CategoryStatus @default(ACTIVE)
  companyId      Int?
  company        Company?       @relation(fields: [companyId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  products       Product[]
  productGroupId Int
  productGroup   ProductGroup   @relation(fields: [productGroupId], references: [id])

  @@unique([name, companyId])
  @@index([companyId])
  @@index([productGroupId])
}

model Supplier {
  id                 Int                 @id @default(autoincrement())
  companyName        String
  contactName        String
  phone              String
  email              String
  address            String
  city               String
  country            String              @default("Colombia")
  status             SupplierStatus      @default(ACTIVE)
  companyId          Int?
  company            Company?            @relation(fields: [companyId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  products           Product[]
  purchaseOrders     PurchaseOrder[]
  code               String?
  purchaseQuotations PurchaseQuotation[]
  purchaseInvoices   PurchaseInvoice[]

  @@unique([companyName, companyId])
  @@unique([email, companyId])
  @@index([companyId])
}

model Product {
  id                       Int                       @id @default(autoincrement())
  code                     String
  name                     String
  categoryId               Int
  supplierId               Int
  quantityAvailable        Int                       @default(0)
  unitCost                 Float                     @default(0)
  salePrice                Float                     @default(0)
  soldQuantity             Int                       @default(0)
  status                   ProductStatus             @default(AVAILABLE)
  type                     ProductType               @default(SALE)
  productGroupId           Int?
  companyId                Int?
  company                  Company?                  @relation(fields: [companyId], references: [id])
  productGroup             ProductGroup?             @relation(fields: [productGroupId], references: [id])
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  category                 Category                  @relation(fields: [categoryId], references: [id])
  supplier                 Supplier                  @relation(fields: [supplierId], references: [id])
  saleDetails              SaleDetail[]
  purchaseOrderLines       PurchaseOrderLine[]
  purchaseRequestItems     PurchaseRequestItem[]
  purchaseQuotationItems   PurchaseQuotationItem[]
  purchaseReceiptItems     PurchaseReceiptItem[]
  inventoryEntryItems      InventoryEntryItem[]
  internalRequisitionItems InternalRequisitionItem[]

  @@unique([code, companyId])
  @@index([name])
  @@index([categoryId])
  @@index([supplierId])
  @@index([productGroupId])
  @@index([companyId])
}

model Sale {
  id             Int          @id @default(autoincrement())
  saleNumber     String
  userId         Int
  client         String?
  discount       Float        @default(0)
  total          Float        @default(0)
  paymentMethod  String       @default("EFECTIVO")
  status         SaleStatus   @default(PENDING)
  remarks        String?
  voidedByUserId Int?
  companyId      Int?
  company        Company?     @relation(fields: [companyId], references: [id])
  voidedByUser   User?        @relation("VoidedSales", fields: [voidedByUserId], references: [id])
  voidedAt       DateTime?
  voidedReason   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id])
  details        SaleDetail[]
  customerId     Int?
  customer       Customer?    @relation(fields: [customerId], references: [id])

  @@unique([saleNumber, companyId])
  @@index([userId])
  @@index([voidedByUserId])
  @@index([companyId])
  @@index([customerId])
}

model SaleDetail {
  id        Int      @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  unitPrice Float
  subtotal  Float
  discount  Float    @default(0)
  total     Float    @default(0)
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([companyId])
}

model AuditLog {
  id              Int      @id @default(autoincrement())
  companyId       Int?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId          Int?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  module          String // e.g., "PRODUCTS", "SALES", "USERS", "COMPANY"
  action          String // e.g., "CREATE", "UPDATE", "DELETE", "VOID", "EXPORT"
  entity          String // e.g., "Product", "Sale", "Category"
  entityId        Int?
  description     String   @db.Text
  oldValues       Json? // Valores antes del cambio (para updates)
  newValues       Json? // Valores después del cambio
  ip              String?
  browser         String?
  operatingSystem String?
  device          String?
  country         String?
  city            String?
  sessionId       String?
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
}

model Discount {
  id         Int           @id @default(autoincrement())
  name       String
  type       DiscountType
  value      Float
  scope      DiscountScope
  productId  Int?
  productIds Json?
  companyId  Int?
  company    Company?      @relation(fields: [companyId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([companyId])
}

model InvoiceCounter {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  date      DateTime
  lastSeq   Int      @default(0)

  @@unique([companyId, date])
  @@index([companyId])
}

model Setting {
  key   String @id
  value String
}

model Permission {
  id       Int              @id @default(autoincrement())
  action   String
  resource String
  roles    RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Module {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  description String?
  isActive    Boolean         @default(true)
  icon        String?
  href        String?
  roles       RoleModule[]
  companies   CompanyModule[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model RoleModule {
  roleId   Int
  moduleId Int
  role     Role   @relation(fields: [roleId], references: [id])
  module   Module @relation(fields: [moduleId], references: [id])

  @@id([roleId, moduleId])
}

model CompanyModule {
  companyId Int
  moduleId  Int
  company   Company @relation(fields: [companyId], references: [id])
  module    Module  @relation(fields: [moduleId], references: [id])

  @@id([companyId, moduleId])
}

model Lead {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  companyName String?
  source      String?
  status      String   @default("NEW")
  companyId   Int?
  company     Company? @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model Contact {
  id         Int      @id @default(autoincrement())
  name       String
  email      String?
  phone      String?
  position   String?
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  companyId  Int?
  company    Company? @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([customerId])
}

model Activity {
  id          Int       @id @default(autoincrement())
  title       String
  type        String // CALL, EMAIL, MEETING
  description String?   @db.Text
  date        DateTime
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id])
  companyId   Int?
  company     Company?  @relation(fields: [companyId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([customerId])
}

model Quote {
  id          Int       @id @default(autoincrement())
  quoteNumber String    @unique
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id])
  total       Float     @default(0)
  status      String    @default("DRAFT")
  validUntil  DateTime?
  companyId   Int?
  company     Company?  @relation(fields: [companyId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([customerId])
}

model LoginHistory {
  id              Int      @id @default(autoincrement())
  userId          Int?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email           String // Email ingresado
  companyId       Int?
  company         Company? @relation(fields: [companyId], references: [id])
  ip              String?
  browser         String?
  operatingSystem String?
  device          String?
  country         String?
  city            String?
  status          String // "SUCCESS", "FAILED"
  reason          String? // e.g., "WRONG_PASSWORD"
  createdAt       DateTime @default(now())

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String // SUCCESS, ERROR, WARNING, INFO
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model UserSession {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId       Int?
  company         Company? @relation(fields: [companyId], references: [id])
  token           String   @unique
  ip              String?
  browser         String?
  operatingSystem String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([userId])
}

model CompanySetting {
  id                    Int      @id @default(autoincrement())
  companyId             Int      @unique
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nit                   String?
  phone                 String?
  website               String?
  socialMedia           Json? // Redes sociales (Facebook, Instagram, etc.)
  invoiceConfig         Json? // Parámetros de facturación personalizada (colores, logo, pie de página, etc.)
  currency              String   @default("COP")
  timezone              String   @default("America/Bogota")
  dateFormat            String   @default("YYYY-MM-DD")
  currencyFormat        String   @default("es-CO")
  allowNegativeStock    Boolean  @default(false)
  automaticCode         Boolean  @default(true)
  decimals              Int      @default(0)
  defaultIva            Float    @default(19.0)
  invoicePrefix         String   @default("VEN")
  invoiceConsecutive    Int      @default(1)
  purchasePrefix        String   @default("COM")
  purchaseConsecutive   Int      @default(1)
  passwordMinLength        Int      @default(6)
  passwordMaxLength        Int      @default(128)
  passwordRequireUppercase Boolean  @default(false)
  passwordRequireLowercase Boolean  @default(false)
  passwordRequireNumbers   Boolean  @default(false)
  passwordRequireSymbols   Boolean  @default(false)
  maxLoginAttempts         Int      @default(5)
  sessionTimeoutMinutes Int      @default(60)
  enable2FA             Boolean  @default(false)
  enableNotifications   Boolean  @default(true)
  smtpHost              String?
  smtpPort              Int?
  smtpUser              String?
  smtpPass              String?
  backupFrequency       String   @default("DAILY") // MANUAL, DAILY, WEEKLY
  backupTime            String?  @default("02:00")
  backupDay             Int?     @default(1)
  backupPath            String?
  registerInventoryCostAsExpense Boolean @default(false)
  updatedAt             DateTime @updatedAt
}

enum PurchaseRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum PurchaseRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PurchaseQuotationStatus {
  DRAFT
  SENT
  RECEIVED
  SELECTED
  REJECTED
}

enum PurchaseReceiptStatus {
  PENDING
  PARTIAL
  COMPLETE
  CANCELLED
}

enum PurchaseInvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PayableStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PurchasePaymentMethod {
  CASH
  TRANSFER
  CHECK
  CREDIT_CARD
  OTHER
}

enum PurchaseItemType {
  MATERIA_PRIMA
  PRODUCTO_VENTA
  SERVICIO
  ACTIVO_FIJO
  INSUMO
  PAPELERIA
  GASTO_ADMINISTRATIVO
  OTROS
}

model PurchaseRequest {
  id            Int                     @id @default(autoincrement())
  requestNumber String                  @unique
  status        PurchaseRequestStatus   @default(DRAFT)
  priority      PurchaseRequestPriority @default(MEDIUM)
  userId        Int
  user          User                    @relation(fields: [userId], references: [id])
  companyId     Int?
  company       Company?                @relation(fields: [companyId], references: [id])
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  items         PurchaseRequestItem[]
  approvals     PurchaseApproval[]
  quotations    PurchaseQuotation[]
  orders        PurchaseOrder[]
}

model PurchaseRequestItem {
  id                Int              @id @default(autoincrement())
  purchaseRequestId Int
  purchaseRequest   PurchaseRequest  @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  productId         Int?
  product           Product?         @relation(fields: [productId], references: [id])
  description       String?
  quantity          Int              @default(1)
  itemType          PurchaseItemType @default(PRODUCTO_VENTA)
  companyId         Int?
  company           Company?         @relation(fields: [companyId], references: [id])
}

model PurchaseApprovalConfig {
  id              Int     @id @default(autoincrement())
  companyId       Int     @unique
  company         Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requireApproval Boolean @default(true)
  levels          Int     @default(1)
}

model PurchaseApproval {
  id                Int             @id @default(autoincrement())
  purchaseRequestId Int
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  userId            Int
  user              User            @relation(fields: [userId], references: [id])
  level             Int             @default(1)
  status            String          @default("APPROVED")
  comments          String?
  companyId         Int?
  company           Company?        @relation(fields: [companyId], references: [id])
  createdAt         DateTime        @default(now())
}

model PurchaseQuotation {
  id                Int                     @id @default(autoincrement())
  quotationNumber   String                  @unique
  purchaseRequestId Int
  purchaseRequest   PurchaseRequest         @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  supplierId        Int
  supplier          Supplier                @relation(fields: [supplierId], references: [id])
  status            PurchaseQuotationStatus @default(DRAFT)
  total             Float                   @default(0)
  companyId         Int?
  company           Company?                @relation(fields: [companyId], references: [id])
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  items             PurchaseQuotationItem[]
  orders            PurchaseOrder[]
}

model PurchaseQuotationItem {
  id                  Int               @id @default(autoincrement())
  purchaseQuotationId Int
  purchaseQuotation   PurchaseQuotation @relation(fields: [purchaseQuotationId], references: [id], onDelete: Cascade)
  productId           Int?
  product             Product?          @relation(fields: [productId], references: [id])
  description         String?
  quantity            Int               @default(1)
  unitPrice           Float             @default(0)
  total               Float             @default(0)
  itemType            PurchaseItemType  @default(PRODUCTO_VENTA)
  companyId           Int?
  company             Company?          @relation(fields: [companyId], references: [id])
}

model PurchaseReceipt {
  id               Int                   @id @default(autoincrement())
  receiptNumber    String                @unique
  purchaseOrderId  Int
  purchaseOrder    PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  status           PurchaseReceiptStatus @default(PENDING)
  receivedDate     DateTime              @default(now())
  companyId        Int?
  company          Company?              @relation(fields: [companyId], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  items            PurchaseReceiptItem[]
  inventoryEntries InventoryEntry[]
  invoices         PurchaseInvoice[]
}

model PurchaseReceiptItem {
  id                Int             @id @default(autoincrement())
  purchaseReceiptId Int
  purchaseReceipt   PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  productId         Int?
  product           Product?        @relation(fields: [productId], references: [id])
  description       String?
  quantityReceived  Int             @default(0)
  companyId         Int?
  company           Company?        @relation(fields: [companyId], references: [id])
}

model InventoryEntry {
  id                Int                  @id @default(autoincrement())
  purchaseReceiptId Int
  purchaseReceipt   PurchaseReceipt      @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  entryDate         DateTime             @default(now())
  companyId         Int?
  company           Company?             @relation(fields: [companyId], references: [id])
  items             InventoryEntryItem[]
}

model InventoryEntryItem {
  id               Int            @id @default(autoincrement())
  inventoryEntryId Int
  inventoryEntry   InventoryEntry @relation(fields: [inventoryEntryId], references: [id], onDelete: Cascade)
  productId        Int
  product          Product        @relation(fields: [productId], references: [id])
  quantityAdded    Int            @default(0)
  companyId        Int?
  company          Company?       @relation(fields: [companyId], references: [id])
}

model PurchaseInvoice {
  id                Int                   @id @default(autoincrement())
  invoiceNumber     String
  purchaseOrderId   Int?
  purchaseOrder     PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseReceiptId Int?
  purchaseReceipt   PurchaseReceipt?      @relation(fields: [purchaseReceiptId], references: [id])
  supplierId        Int
  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  status            PurchaseInvoiceStatus @default(DRAFT)
  subtotal          Float                 @default(0)
  taxAmount         Float                 @default(0)
  total             Float                 @default(0)
  issueDate         DateTime              @default(now())
  dueDate           DateTime?
  companyId         Int?
  company           Company?              @relation(fields: [companyId], references: [id])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  payables          AccountsPayable[]
}

model AccountsPayable {
  id                Int               @id @default(autoincrement())
  purchaseInvoiceId Int
  purchaseInvoice   PurchaseInvoice   @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  amount            Float             @default(0)
  paidAmount        Float             @default(0)
  status            PayableStatus     @default(PENDING)
  dueDate           DateTime
  companyId         Int?
  company           Company?          @relation(fields: [companyId], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  payments          PurchasePayment[]
}

model PurchasePayment {
  id                Int                   @id @default(autoincrement())
  accountsPayableId Int
  accountsPayable   AccountsPayable       @relation(fields: [accountsPayableId], references: [id], onDelete: Cascade)
  amount            Float
  paymentDate       DateTime              @default(now())
  paymentMethod     PurchasePaymentMethod @default(TRANSFER)
  reference         String?
  companyId         Int?
  company           Company?              @relation(fields: [companyId], references: [id])
  createdAt         DateTime              @default(now())
}

enum InternalRequisitionStatus {
  DRAFT
  PENDING_BOSS
  APPROVED
  REJECTED
  CONVERTED_TO_PURCHASE
  CANCELLED
}

model InternalRequisition {
  id             Int                       @id @default(autoincrement())
  requisitionNum String                    @unique
  status         InternalRequisitionStatus @default(DRAFT)
  priority       PurchaseRequestPriority   @default(MEDIUM)
  userId         Int
  user           User                      @relation(fields: [userId], references: [id])
  companyId      Int?
  company        Company?                  @relation(fields: [companyId], references: [id])
  notes          String?                   @db.Text
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  deletedAt      DateTime?
  items          InternalRequisitionItem[]

  @@index([companyId])
  @@index([userId])
}

model InternalRequisitionItem {
  id                    Int                 @id @default(autoincrement())
  internalRequisitionId Int
  internalRequisition   InternalRequisition @relation(fields: [internalRequisitionId], references: [id], onDelete: Cascade)
  productId             Int?
  product               Product?            @relation(fields: [productId], references: [id])
  description           String?
  quantity              Int                 @default(1)
  unit                  String?             @default("UN")
  itemType              PurchaseItemType    @default(PRODUCTO_VENTA)
  notes                 String?             @db.Text
  companyId             Int?
  company               Company?            @relation(fields: [companyId], references: [id])
  deletedAt             DateTime?

  @@index([internalRequisitionId])
  @@index([productId])
  @@index([companyId])
}

model Position {
  id         Int    @id @default(autoincrement())
  name       String
  baseSalary Float  @default(0)

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  employees Employee[]

  @@unique([name, companyId])
  @@index([companyId])
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum NoveltyType {
  BONUS
  DEDUCTION
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

model Employee {
  id          Int            @id @default(autoincrement())
  firstName   String
  lastName    String
  documentId  String
  email       String?
  phone       String?
  address     String?
  department  String?
  positionId  Int?
  position    Position?      @relation(fields: [positionId], references: [id])
  hireDate    DateTime
  status      EmployeeStatus @default(ACTIVE)
  bankName    String?
  bankAccount String?

  userId Int?  @unique
  user   User? @relation(fields: [userId], references: [id])

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  payrollDetails PayrollDetail[]
  novelties      EmployeeNovelty[]

  @@unique([documentId, companyId])
  @@index([positionId])
  @@index([companyId])
}

model Payroll {
  id          Int           @id @default(autoincrement())
  code        String
  periodStart DateTime
  periodEnd   DateTime
  paymentDate DateTime?
  status      PayrollStatus @default(DRAFT)
  totalAmount Float         @default(0)

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  details          PayrollDetail[]
  appliedNovelties EmployeeNovelty[]

  @@unique([code, companyId])
  @@index([companyId])
}

model PayrollDetail {
  id        Int     @id @default(autoincrement())
  payrollId Int
  payroll   Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  baseSalary Float   @default(0)
  additions  Float   @default(0)
  deductions Float   @default(0)
  netPay     Float   @default(0)
  notes      String? @db.Text

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payrollId])
  @@index([employeeId])
  @@index([companyId])
}

model EmployeeNovelty {
  id          Int         @id @default(autoincrement())
  employeeId  Int
  employee    Employee    @relation(fields: [employeeId], references: [id])
  type        NoveltyType
  amount      Float
  description String
  isRecurring Boolean     @default(false)

  appliedPayrollId Int?
  appliedPayroll   Payroll? @relation(fields: [appliedPayrollId], references: [id])

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([appliedPayrollId])
  @@index([companyId])
}
