generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma-tenant/client"
}

datasource db {
  provider = "mysql"
  url      = env("TENANT_DATABASE_URL")
}

enum SaleStatus {
  PENDING
  REVIEWED
  PAID
  COMPLETED
  VOIDED
  RETURNED
}

enum DiscountScope {
  GLOBAL
  PRODUCT
  PRODUCTS
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProductStatus {
  AVAILABLE
  OUT_OF_STOCK
}

enum ProductType {
  SALE
  RAW_MATERIAL
  FINISHED_GOOD
  SUPPLY
  SERVICE
  FIXED_ASSET
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  WON
}

enum OpportunityStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
  CANCELLED
}

enum ExpenseCategory {
  MARKETING
  SUPPLIES
  UTILITIES
  PAYROLL
  OTHER
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id            Int              @id @default(autoincrement())
  name          String
  email         String?          @unique
  phone         String?
  company       String?
  address       String?
  city          String?
  country       String           @default("Colombia")
  status        CustomerStatus   @default(ACTIVE)
  companyId     String?          // Relación lógica con Platform DB (Company)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  opportunities Opportunity[]
  contacts      Contact[]
  activities    Activity[]
  quotes        Quote[]
  code          String?
  sales         Sale[]
  documentType           String?
  documentNumber         String?
  altPhone               String?
  neighborhood           String?
  department             String?
  deliveryAddress        String?
  preferredContactMethod String?
  preferredContactTime   String?
  creditNotes            String?         @db.Text
  creditStatus           String?         @default("ACTIVE")
  creditOperations       CreditOperation[]
  creditPayments         CreditPayment[]
  creditCollectionActivities CreditCollectionActivity[]
  storeOrders            StoreOrder[]

  @@index([companyId])
}

model Opportunity {
  id             Int              @id @default(autoincrement())
  title          String
  customerId     Int
  stage          OpportunityStage @default(NEW)
  estimatedValue Float            @default(0)
  probability    Int              @default(0)
  companyId      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  customer       Customer         @relation(fields: [customerId], references: [id], map: "fk_opportunity_customer")

  @@index([companyId])
  @@index([customerId])
}

model PurchaseOrder {
  id               Int                 @id @default(autoincrement())
  orderNumber      String              @unique
  supplierId       Int
  status           PurchaseOrderStatus @default(DRAFT)
  total            Float               @default(0)
  expectedDelivery DateTime?
  companyId        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  supplier         Supplier            @relation(fields: [supplierId], references: [id], map: "fk_po_supplier")
  lines            PurchaseOrderLine[]

  @@index([companyId])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int
  productId       Int?
  quantity        Int           @default(1)
  unitPrice       Float         @default(0)
  total           Float         @default(0)
  companyId       String?
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, map: "fk_poline_po")
  product         Product?      @relation(fields: [productId], references: [id], map: "fk_poline_product")

  @@index([companyId])
  @@index([purchaseOrderId])
  @@index([productId])
}

model Expense {
  id          Int             @id @default(autoincrement())
  description String
  amount      Float
  category    ExpenseCategory @default(OTHER)
  date        DateTime        @default(now())
  companyId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companyId])
}

model ProductGroup {
  id        Int       @id @default(autoincrement())
  name      String
  code      String?
  status    String    @default("ACTIVE")
  companyId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  categories Category[]

  @@unique([name, companyId])
  @@index([companyId])
}

model Category {
  id             Int            @id @default(autoincrement())
  name           String
  code           String?
  description    String?
  status         CategoryStatus @default(ACTIVE)
  companyId      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  products       Product[]
  productGroupId Int
  productGroup   ProductGroup   @relation(fields: [productGroupId], references: [id], map: "fk_cat_pgroup")

  @@unique([name, companyId])
  @@index([companyId])
  @@index([productGroupId])
}

model Supplier {
  id             Int             @id @default(autoincrement())
  companyName    String
  contactName    String
  phone          String
  email          String
  address        String
  city           String
  country        String          @default("Colombia")
  status         SupplierStatus  @default(ACTIVE)
  companyId      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]
  purchaseOrders PurchaseOrder[]
  code           String?

  @@unique([companyName, companyId])
  @@unique([email, companyId])
  @@index([companyId])
}

model Product {
  id                 Int                 @id @default(autoincrement())
  code               String
  name               String
  categoryId         Int
  supplierId         Int
  quantityAvailable  Int                 @default(0)
  reservedQuantity   Int                 @default(0)
  unitCost           Float               @default(0)
  salePrice          Float               @default(0)
  soldQuantity       Int                 @default(0)
  status             ProductStatus       @default(AVAILABLE)
  type               ProductType         @default(SALE)
  isPublishedWeb     Boolean             @default(false)
  webPrice           Float?
  description        String?             @db.Text
  imageUrl           String?             @db.LongText
  galleryImages      String?             @db.LongText
  videoUrl           String?             @db.Text
  productGroupId     Int?
  companyId          String?
  branchId           Int?
  branch             Branch?             @relation(fields: [branchId], references: [id], map: "fk_prod_branch")
  isInheritedFromMain Boolean            @default(false)
  mainProductId      Int?
  productGroup       ProductGroup?       @relation(fields: [productGroupId], references: [id], map: "fk_prod_pgroup")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  category           Category            @relation(fields: [categoryId], references: [id], map: "fk_prod_cat")
  supplier           Supplier            @relation(fields: [supplierId], references: [id], map: "fk_prod_sup")
  saleDetails        SaleDetail[]
  purchaseOrderLines PurchaseOrderLine[]
  comboItems         ComboItem[]
  creditOperationItems CreditOperationItem[]
  storeOrderItems    StoreOrderItem[]

  @@unique([code, companyId])
  @@index([name])
  @@index([categoryId])
  @@index([supplierId])
  @@index([productGroupId])
  @@index([companyId])
  @@index([branchId])
}

model Sale {
  id             Int          @id @default(autoincrement())
  saleNumber     String
  userId         Int          // Referencia lógica a User (Platform)
  client         String?
  discount       Float        @default(0)
  total          Float        @default(0)
  paymentMethod  String       @default("EFECTIVO")
  status         SaleStatus   @default(PENDING)
  remarks        String?
  voidedByUserId Int?
  companyId      String?
  voidedAt       DateTime?
  voidedReason   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  details        SaleDetail[]
  customerId     Int?
  customer       Customer?    @relation(fields: [customerId], references: [id], map: "fk_sale_cust")
  branchId       Int?
  branch         Branch?      @relation(fields: [branchId], references: [id], map: "fk_sale_branch")
  creditOperation CreditOperation?
  storeOrder     StoreOrder?

  @@unique([saleNumber, companyId])
  @@index([userId])
  @@index([voidedByUserId])
  @@index([companyId])
  @@index([customerId])
  @@index([branchId])
}

model SaleDetail {
  id        Int      @id @default(autoincrement())
  saleId    Int
  productId Int?
  comboId   Int?
  comboName String?
  isCombo   Boolean  @default(false)
  quantity  Int
  unitPrice Float
  subtotal  Float
  discount  Float    @default(0)
  total     Float    @default(0)
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade, map: "fk_sdetail_sale")
  product   Product? @relation(fields: [productId], references: [id], map: "fk_sdetail_prod")
  combo     Combo?   @relation(fields: [comboId], references: [id], map: "fk_sdetail_combo")

  @@index([saleId])
  @@index([productId])
  @@index([comboId])
  @@index([companyId])
}

model Discount {
  id         Int           @id @default(autoincrement())
  name       String
  type       DiscountType
  value      Float
  scope      DiscountScope
  productId  Int?
  productIds Json?
  companyId  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([companyId])
}

model InvoiceCounter {
  id        Int      @id @default(autoincrement())
  companyId String
  date      DateTime
  lastSeq   Int      @default(0)

  @@unique([companyId, date])
  @@index([companyId])
}

model Lead {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  companyName String?
  source      String?
  status      String   @default("NEW")
  companyId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

model Contact {
  id         Int      @id @default(autoincrement())
  name       String
  email      String?
  phone      String?
  position   String?
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], map: "fk_acc_cust")
  companyId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
  @@index([customerId])
}

model Activity {
  id          Int       @id @default(autoincrement())
  title       String
  type        String    // CALL, EMAIL, MEETING
  description String?   @db.Text
  date        DateTime
  userId      Int
  customerId  Int?
  customer    Customer? @relation(fields: [customerId], references: [id], map: "fk_inv_cust")
  companyId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([customerId])
}

model Quote {
  id          Int       @id @default(autoincrement())
  quoteNumber String    @unique
  customerId  Int
  customer    Customer  @relation(fields: [customerId], references: [id], map: "fk_pay_cust")
  total       Float     @default(0)
  status      String    @default("DRAFT")
  validUntil  DateTime?
  companyId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([companyId])
  @@index([customerId])
}

model Branch {
  id        Int       @id @default(autoincrement())
  name      String
  code      String?
  address   String?
  phone     String?
  city      String?
  isMain    Boolean   @default(false)
  companyId String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]
  sales     Sale[]
  creditOperations CreditOperation[]

  @@index([companyId])
}

// ==========================================
// MÓDULO COMBOS (PAQUETES COMERCIALES)
// ==========================================

model Combo {
  id              Int          @id @default(autoincrement())
  code            String?
  name            String
  description     String?      @db.Text
  image           String?      @db.LongText
  pricingType     String       @default("DISCOUNT_PERCENT")
  discountPercent Float        @default(0)
  customPrice     Float?
  calculatedCost  Float        @default(0)
  commercialPrice Float        @default(0)
  finalPrice      Float        @default(0)
  targetQuantity  Int?
  isActive        Boolean      @default(true)
  companyId       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           ComboItem[]
  saleDetails     SaleDetail[]
  creditOperationItems CreditOperationItem[]

  @@unique([name, companyId])
  @@index([companyId])
  @@index([isActive])
}

model ComboItem {
  id        Int      @id @default(autoincrement())
  comboId   Int
  combo     Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade, map: "fk_citem_combo")
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, map: "fk_citem_prod")
  quantity  Int      @default(1)
  companyId String?

  @@unique([comboId, productId])
  @@index([comboId])
  @@index([productId])
  @@index([companyId])
}

// ==========================================
// MÓDULO CARTERA Y VENTAS A CRÉDITO (TENANT)
// ==========================================

enum CreditDeliveryMode {
  IMMEDIATE
  UPON_PAYMENT
}

enum CreditOperationStatus {
  ACTIVE
  PAID
  DELIVERED
  CANCELLED
  OVERDUE
}

enum CreditDeliveryStatus {
  PENDING
  PARTIAL
  DELIVERED
  CANCELLED
}

enum CreditInstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum CreditPaymentStatus {
  CONFIRMED
  VOIDED
}

model CreditOperation {
  id                   Int                       @id @default(autoincrement())
  code                 String
  companyId            String?
  customerId           Int
  customer             Customer                  @relation(fields: [customerId], references: [id], map: "fk_croper_cust")
  userId               Int                       // Ref lógica a User
  branchId             Int?
  branch               Branch?                   @relation(fields: [branchId], references: [id], map: "fk_croper_branch")
  saleId               Int?                      @unique
  sale                 Sale?                     @relation(fields: [saleId], references: [id], map: "fk_croper_sale")

  deliveryMode         CreditDeliveryMode        @default(IMMEDIATE)
  status               CreditOperationStatus     @default(ACTIVE)
  deliveryStatus       CreditDeliveryStatus      @default(PENDING)

  totalAmount          Float                     @default(0)
  downPayment          Float                     @default(0)
  paidAmount           Float                     @default(0)
  balance              Float                     @default(0)

  // Control de reservas de inventario
  isStockReserved      Boolean                   @default(false)
  reservationExpiresAt DateTime?

  // Fechas y condiciones pactadas
  startDate            DateTime                  @default(now())
  dueDate              DateTime?
  lastPaymentDate      DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?                   @db.Text

  notes                String?                   @db.Text
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  items                CreditOperationItem[]
  installments         CreditInstallment[]
  payments             CreditPayment[]
  deliveries           CreditDelivery[]
  collectionActivities CreditCollectionActivity[]

  @@unique([code, companyId])
  @@index([companyId])
  @@index([customerId])
  @@index([userId])
  @@index([branchId])
  @@index([status])
  @@index([deliveryStatus])
  @@index([dueDate])
}

model CreditOperationItem {
  id                   Int                       @id @default(autoincrement())
  creditOperationId    Int
  creditOperation      CreditOperation           @relation(fields: [creditOperationId], references: [id], onDelete: Cascade, map: "fk_croperitem_oper")
  productId            Int?
  product              Product?                  @relation(fields: [productId], references: [id], map: "fk_croperitem_prod")
  comboId              Int?
  combo                Combo?                    @relation(fields: [comboId], references: [id], map: "fk_croperitem_combo")
  comboName            String?
  isCombo              Boolean                   @default(false)

  quantity             Int                       @default(1)
  deliveredQuantity    Int                       @default(0)
  reservedQuantity     Int                       @default(0)

  unitPrice            Float                     @default(0)
  subtotal             Float                     @default(0)
  discount             Float                     @default(0)
  total                Float                     @default(0)

  companyId            String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  deliveryItems        CreditDeliveryItem[]

  @@index([creditOperationId])
  @@index([productId])
  @@index([comboId])
  @@index([companyId])
}

model CreditInstallment {
  id                   Int                       @id @default(autoincrement())
  creditOperationId    Int
  creditOperation      CreditOperation           @relation(fields: [creditOperationId], references: [id], onDelete: Cascade, map: "fk_crinst_oper")
  installmentNumber    Int
  amount               Float                     @default(0)
  paidAmount           Float                     @default(0)
  dueDate              DateTime
  status               CreditInstallmentStatus   @default(PENDING)
  notes                String?
  companyId            String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  paymentAllocations   CreditPaymentInstallment[]

  @@index([creditOperationId])
  @@index([companyId])
  @@index([dueDate])
  @@index([status])
}

model CreditPayment {
  id                   Int                       @id @default(autoincrement())
  receiptNumber        String
  creditOperationId    Int
  creditOperation      CreditOperation           @relation(fields: [creditOperationId], references: [id], onDelete: Cascade, map: "fk_crpay_oper")
  customerId           Int
  customer             Customer                  @relation(fields: [customerId], references: [id], map: "fk_crpay_cust")
  amount               Float
  paymentDate          DateTime                  @default(now())
  paymentMethod        String                    @default("EFECTIVO")
  reference            String?
  notes                String?                   @db.Text
  status               CreditPaymentStatus       @default(CONFIRMED)
  voidedAt             DateTime?
  voidedReason         String?                   @db.Text
  voidedByUserId       Int?

  registeredByUserId   Int                       // Ref lógica a User
  companyId            String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  allocations          CreditPaymentInstallment[]

  @@unique([receiptNumber, companyId])
  @@index([creditOperationId])
  @@index([customerId])
  @@index([registeredByUserId])
  @@index([companyId])
  @@index([paymentDate])
  @@index([status])
}

model CreditPaymentInstallment {
  id                   Int                       @id @default(autoincrement())
  creditPaymentId      Int
  creditPayment        CreditPayment             @relation(fields: [creditPaymentId], references: [id], onDelete: Cascade, map: "fk_crpayinst_pay")
  creditInstallmentId  Int
  creditInstallment    CreditInstallment         @relation(fields: [creditInstallmentId], references: [id], onDelete: Cascade, map: "fk_crpayinst_inst")
  amount               Float                     @default(0)
  companyId            String?
  createdAt            DateTime                  @default(now())

  @@index([creditPaymentId])
  @@index([creditInstallmentId])
  @@index([companyId])
}

model CreditDelivery {
  id                   Int                       @id @default(autoincrement())
  deliveryNumber       String
  creditOperationId    Int
  creditOperation      CreditOperation           @relation(fields: [creditOperationId], references: [id], onDelete: Cascade, map: "fk_crdel_oper")
  deliveryDate         DateTime                  @default(now())
  deliveredByUserId    Int                       // Ref lógica a User
  notes                String?                   @db.Text
  companyId            String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  items                CreditDeliveryItem[]

  @@unique([deliveryNumber, companyId])
  @@index([creditOperationId])
  @@index([deliveredByUserId])
  @@index([companyId])
}

model CreditDeliveryItem {
  id                   Int                       @id @default(autoincrement())
  creditDeliveryId     Int
  creditDelivery       CreditDelivery            @relation(fields: [creditDeliveryId], references: [id], onDelete: Cascade, map: "fk_crdelitem_del")
  operationItemId      Int
  operationItem        CreditOperationItem       @relation(fields: [operationItemId], references: [id], onDelete: Cascade, map: "fk_crdelitem_item")
  quantity             Int                       @default(1)
  companyId            String?
  createdAt            DateTime                  @default(now())

  @@index([creditDeliveryId])
  @@index([operationItemId])
  @@index([companyId])
}

model CreditCollectionActivity {
  id                   Int                       @id @default(autoincrement())
  creditOperationId    Int
  creditOperation      CreditOperation           @relation(fields: [creditOperationId], references: [id], onDelete: Cascade, map: "fk_crcoll_oper")
  customerId           Int
  customer             Customer                  @relation(fields: [customerId], references: [id], map: "fk_crcoll_cust")
  userId               Int                       // Ref lógica a User
  channel              String
  result               String
  notes                String                    @db.Text
  commitmentDate       DateTime?
  commitmentAmount     Float?
  companyId            String?
  createdAt            DateTime                  @default(now())

  @@index([creditOperationId])
  @@index([customerId])
  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
  @@index([commitmentDate])
}

model OnlineStore {
  id                      String        @id @default(cuid())
  slug                    String        @unique
  name                    String
  description             String?       @db.Text
  logoUrl                 String?       @db.LongText
  bannerUrl               String?       @db.LongText
  phone                   String?
  email                   String?
  address                 String?
  city                    String?       @default("Cali")
  currency                String        @default("COP")
  status                  String        @default("ACTIVE")
  whatsappMessage         String?       @db.Text
  announcementText        String?       @db.Text
  themeColor              String?       @default("#3b82f6")
  instagramUrl            String?
  facebookUrl             String?
  tiktokUrl               String?
  themeConfig             String?       @db.LongText
  allowDelivery           Boolean       @default(true)
  allowPickup             Boolean       @default(true)
  allowCoordinate         Boolean       @default(true)
  deliveryCost            Float         @default(0)
  deliveryNotes           String?       @db.Text
  pickupAddress           String?       @db.Text
  minOrderAmount          Float         @default(0)
  freeShippingThreshold   Float?        @default(0)
  customDomain            String?       @unique
  domainStatus            String        @default("DISCONNECTED")
  domainVerificationToken String?
  companyId               String?       @unique

  orders                  StoreOrder[]
  domains                 StoreDomain[]

  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([slug])
  @@index([customDomain])
}

model StoreDomain {
  id                Int           @id @default(autoincrement())
  domain            String        @unique
  storeId           String
  store             OnlineStore   @relation(fields: [storeId], references: [id], onDelete: Cascade, map: "fk_stdom_store")
  status            String        @default("PENDING_VERIFICATION")
  verificationType  String        @default("TXT")
  verificationToken String
  verifiedAt        DateTime?
  companyId         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([domain])
  @@index([storeId])
  @@index([companyId])
}

model StoreOrder {
  id                    Int                 @id @default(autoincrement())
  orderNumber           String
  orderToken            String              @unique
  storeId               String
  store                 OnlineStore         @relation(fields: [storeId], references: [id], onDelete: Cascade, map: "fk_stord_store")
  companyId             String?

  customerName          String
  customerPhone         String
  customerEmail         String?

  deliveryMode          String
  deliveryAddress       String?
  deliveryCity          String?
  deliveryNeighborhood  String?
  notes                 String?             @db.Text

  subtotal              Float
  deliveryCost          Float               @default(0)
  discount              Float               @default(0)
  total                 Float

  status                String              @default("PENDING_REVIEW")
  rejectionReason       String?             @db.Text

  privacyAccepted       Boolean             @default(true)
  privacyVersion        String?             @default("1.0")
  privacyAcceptedAt     DateTime?           @default(now())

  idempotencyKey        String?             @unique
  saleId                Int?                @unique
  sale                  Sale?               @relation(fields: [saleId], references: [id], onDelete: SetNull, map: "fk_stord_sale")
  customerId            Int?
  customer              Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull, map: "fk_stord_cust")

  reviewedById          Int?
  reviewedAt            DateTime?

  items                 StoreOrderItem[]
  history               StoreOrderHistory[]

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([orderNumber, companyId])
  @@index([storeId])
  @@index([companyId])
  @@index([orderToken])
  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
}

model StoreOrderItem {
  id                    Int                 @id @default(autoincrement())
  orderId               Int
  order                 StoreOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "fk_stordit_ord")
  productId             Int
  product               Product             @relation(fields: [productId], references: [id], map: "fk_stordit_prod")

  productName           String
  productCode           String
  productImage          String?             @db.LongText
  quantity              Int                 @default(1)
  unitPrice             Float               @default(0)
  subtotal              Float               @default(0)

  createdAt             DateTime            @default(now())

  @@index([orderId])
  @@index([productId])
}

model StoreOrderHistory {
  id                    Int                 @id @default(autoincrement())
  orderId               Int
  order                 StoreOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "fk_stordhist_ord")
  previousStatus        String?
  newStatus             String
  comment               String?             @db.Text
  changedByUserId       Int?
  createdAt             DateTime            @default(now())

  @@index([orderId])
  @@index([createdAt])
}
